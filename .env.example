# ============================================================
#  .env.example  —  TEMPLATE ONLY (safe to commit)
#
#  HOW TO USE:
#    1. Copy this file to `.env`   ->   cp .env.example .env
#    2. Fill in REAL values in `.env` (never here, never in git)
#    3. `.env` is gitignored, so your secrets stay local
#
#  RULE: real secrets ONLY ever live in `.env`, never in this file.
# ============================================================

# --- App ---
APP_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=

# --- API keys (add your own; keep names, leave values blank) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=

# --- Auth / logins ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
JWT_SECRET=
